# PostgreSQL connection. On Railway this is provided by the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# First admin user. Created on startup only if no user with this name exists.
# Set these as Railway variables; never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Optional
PORT=3000
DATABASE_POOL_MAX=10
